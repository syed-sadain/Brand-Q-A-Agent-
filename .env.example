# ============================================================================
# Brand Q&A Agent — environment configuration template
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# NEVER commit a real `.env` file (it is git-ignored).
# ============================================================================

# ----------------------------------------------------------------- application
APP_NAME=Brand Q&A Agent
APP_ENV=local
APP_DEBUG=false
API_VERSION=v1
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------ LLM provider
# LLM_PROVIDER: openai | anthropic | google
LLM_PROVIDER=openai
# This example model is deprecated by its provider and has an announced shutdown
# date of 2027-01-14; select a supported model in LLM_MODEL before that date.
LLM_MODEL=gpt-4o-mini
# Generic key for the selected provider. Provider-specific keys below are also
# honoured (and used as a fallback when LLM_API_KEY is empty).
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# ------------------------------------------------------------- embedding provider
# EMBEDDING_PROVIDER: openai | google | hashing
#   * openai / google require a real API key.
#   * "hashing" is a deterministic, offline embedding used for local development
#     and the automated test-suite (no API key required).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
# Must match the vector index dimension. text-embedding-3-small = 1536,
# models/gemini-embedding-001 = 3072.
# For EMBEDDING_PROVIDER=hashing a smaller value (e.g. 256) is convenient.
EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------ vector store
# VECTOR_STORE_PROVIDER: pinecone | chroma | memory
#   * pinecone — primary production backend (requires PINECONE_API_KEY).
#   * chroma   — optional local backend (requires `pip install chromadb`).
#   * memory   — process-local store for local demos and automated tests.
VECTOR_STORE_PROVIDER=pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=brand-qa-agent
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
CHROMA_PERSIST_DIR=./.chroma
# Local JSON registry used to detect stale vectors when a document's chunk
# count shrinks after re-ingestion.
DOCUMENT_REGISTRY_PATH=./.data/document_registry.json

# ---------------------------------------------------------- retrieval / chunking
CHUNK_SIZE=400
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5

# ------------------------------------------------------------------ outbound HTTP
HTTP_TIMEOUT=15
HTTP_MAX_BYTES=5000000
HTTP_MAX_REDIRECTS=5
HTTP_USER_AGENT=BrandQAAgent/1.0 (+https://example.com/bot)

# ------------------------------------------------------------------ security
# Only set ALLOW_PRIVATE_NETWORKS=true for controlled local testing.
ALLOW_PRIVATE_NETWORKS=false

# ------------------------------------------------------------------ logging
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_JSON=false
